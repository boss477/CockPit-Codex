{
  "manifest_version": 3,
  "name": "WebMCP Universal Bridge",
  "version": "1.0.5",
  "description": "Injects native WebMCP modelContext tools into WhatsApp Web, Motion, and any website with a live two-way bridge to WebMCP Forge.",
  "key": "",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://app.usemotion.com/*",
    "https://motion.so/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "<all_urls>"
  ],
  "externally_connectable": {
    "matches": [
      "https://*.netlify.app/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "WebMCP Universal Bridge"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ]
}
