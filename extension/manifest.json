{
  "manifest_version": 3,
  "name": "WebMCP Universal Bridge",
  "version": "1.0.1",
  "description": "Injects native WebMCP modelContext tools into WhatsApp Web, Motion, and any website for AI agent control.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "WebMCP Universal Bridge"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["bridge.js"],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ]
}
