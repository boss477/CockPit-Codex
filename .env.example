# Optional. Raises the GitHub API rate limit when analyzing arbitrary public
# repositories. Unauthenticated GitHub allows 60 requests per hour per IP and
# serverless IPs are shared, so without this a deployed Forge will usually fail
# on a pasted repo URL. A classic PAT with no scopes is enough (public data only).
# The bundled demo storefront needs no network access and no key.
GITHUB_TOKEN=

# Required for WebMCP to work on a deployed domain. WebMCP runs as a Chrome
# origin trial gated per-origin; localhost is exempt, your Vercel domain is not.
# Register the domain at the Chrome origin trials console and paste the token.
NEXT_PUBLIC_WEBMCP_ORIGIN_TRIAL_TOKEN=
